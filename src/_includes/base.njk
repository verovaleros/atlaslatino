<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# `| safe` here prevents double-escaping, not escaping. On paginated
     pages title/description come from eleventyComputed, which renders
     them as Nunjucks templates and escapes them once already; escaping
     again turned a name like O'Brien into "O&amp;#39;Brien" in the tab
     and in search results. #}
  <title>{% if title %}{{ title | safe }} · {% endif %}AtlasLatino</title>
  <meta name="description" content="{{ (description or 'AtlasLatino maps Latin American researchers and their work.') | safe }}">
  {# Fonts are loaded as a plain stylesheet (no npm dependency, no JS).
     If Google Fonts is unreachable or blocked, the font-family fallback
     stacks in style.css keep the site fully readable. #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <div class="shell">
    <header class="site">
      <a class="wordmark" href="{{ '/' | url }}">Atlas<span>Latino</span></a>
      <nav class="site-nav">
        <a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>Feed</a>
        <a href="{{ '/people/' | url }}"{% if page.url == '/people/' %} aria-current="page"{% endif %}>People</a>
        <a href="{{ '/events/' | url }}"{% if page.url.startsWith('/events/') %} aria-current="page"{% endif %}>Events</a>
        <a href="https://github.com/verovaleros/atlaslatino">Contribute</a>
        <a href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site">
      <div class="footer-body">
        <span>Visibility for Latin American research. Not a ranking.</span>
        <a href="https://github.com/verovaleros/atlaslatino">Add yourself or your research →</a>
        <a href="https://buymeacoffee.com/verovaleros">Support this project →</a>
      </div>
    </footer>
  </div>
</body>
</html>
