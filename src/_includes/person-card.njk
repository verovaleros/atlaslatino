{#
  One researcher card. Extracted so the People index and the per-axis
  people pages (field/type/country) render people identically.
  Expects: `person` ({ slug, data }), and the global `relations`.
#}
{% set lastEntry = relations.researchByPerson[person.slug][0] %}
<li class="person-card">
  <a class="person-card-link" href="{{ ('/people/' + person.slug + '/') | url }}">
    <span class="person-card-photo person-card-photo--invader">{{ person.slug | invader | safe }}</span>
    <span class="person-card-name">
      {{ person.data.name }}
      {% if person.data.country %}<span class="country-tag">{{ person.data.country }}</span>{% endif %}
    </span>
    {% if person.data.affiliation %}
      <span class="person-card-affiliation">{{ person.data.affiliation }}</span>
    {% endif %}
    {% if lastEntry %}
      <span class="person-card-last">
        <span class="ref-kind">Latest</span>
        {{ lastEntry.data.title }}
      </span>
    {% endif %}
  </a>
</li>
